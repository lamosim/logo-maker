# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/
.ruff_cache/
*.egg-info/
dist/
build/

# Secrets
.env
.env.*
!.env.example

# macOS
.DS_Store

# Fetched font files are reproducible from assets/fonts/catalog.json and manifest.json
assets/fonts/*/*.ttf
assets/fonts/*/*.otf
assets/fonts/*/instances/
# Staging folders of fetches in progress (or killed): assets/fonts/<slug>.<random>.tmp
assets/fonts/*.tmp/
# A package build in progress (or killed): its staging folder, and the previous package set aside during the swap
brands/*/package.tmp/
brands/*/package.old.tmp/

# Local Claude settings
.claude/settings.local.json

# Superpowers plan workspaces (ledgers, briefs, review packages)
.superpowers/
