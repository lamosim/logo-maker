# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/
.ruff_cache/
*.egg-info/
dist/
build/

# Secrets
.env
.env.*
!.env.example

# macOS
.DS_Store

# The font cache: every folder under assets/fonts/, a family's fetched files (TTFs, licence, manifest.json, instances/) and the
# <slug>.<random>.tmp staging folder of a fetch in progress or killed. `logomaker fonts fetch` makes them again from
# assets/fonts/catalog.json, the one tracked file here; a package carries its own copies of its fonts in package/fonts/.
assets/fonts/*/
# A package build in progress (or killed): its staging folder, and the previous package set aside during the swap
brands/*/package.tmp/
brands/*/package.old.tmp/

# Local Claude settings
.claude/settings.local.json

# Superpowers plan workspaces (ledgers, briefs, review packages)
.superpowers/
