# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/
.ruff_cache/
*.egg-info/
dist/
build/

# Secrets
.env
.env.*
!.env.example

# macOS
.DS_Store

# Fetched font files are reproducible from assets/fonts/catalog.json and manifest.json
assets/fonts/*/*.ttf
assets/fonts/*/*.otf
assets/fonts/*/instances/
# Staging folders of fetches in progress (or killed): assets/fonts/<slug>.<random>.tmp
assets/fonts/*.tmp/
# Staging folder of a package build in progress (or killed): brands/<slug>/package.tmp
brands/*/package.tmp/

# Local Claude settings
.claude/settings.local.json

# Superpowers plan workspaces (ledgers, briefs, review packages)
.superpowers/
